@startuml uc-00-vue-ensemble
title Rolliste — Vue d'ensemble des cas d'utilisation (v0.3)
!include _style.puml
left to right direction

' ===== Acteurs : une seule colonne, de haut en bas =====
actor "Visiteur" as Visitor
actor "Utilisateur" as User
actor "Meneur" as GM
actor "Joueur" as Player
actor "Administrateur" as Admin

' En « left to right direction », un tiret simple (-) garde les deux
' acteurs dans la même colonne : la colonne se lit de haut en bas.
Visitor <|- User
User <|- GM
User <|- Player
User <|- Admin

' Liens invisibles : imposent l'ordre Meneur → Joueur → Administrateur
GM -[hidden]> Player
Player -[hidden]> Admin

rectangle "Rolliste" {
  package "Compte" as P_Account {
    label "Détail : uc-01" as L_P_Account
  }
  package "Personnages & Parties" as P_Parties {
    label "Détail : uc-02" as L_P_Parties
  }
  package "Jeu en séance & Compendium" as P_Play {
    label "Détail : uc-03" as L_P_Play
  }
  package "Administration" as P_Admin {
    label "Détail : uc-01" as L_P_Admin
  }
}

Visitor --> P_Account
User --> P_Parties
GM --> P_Parties
Player --> P_Play
GM --> P_Play
Admin --> P_Admin
@enduml
