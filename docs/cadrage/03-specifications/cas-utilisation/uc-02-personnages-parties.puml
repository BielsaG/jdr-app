@startuml uc-02-personnages-parties
title Rolliste — Personnages et parties (v0.3)
!include _style.puml
left to right direction

actor "Utilisateur" as User
actor "Joueur" as Player
actor "Meneur" as GM

User <|-- Player
User <|-- GM

rectangle "Rolliste" {
  package "Personnages" {
    usecase "Gérer ses PJ\n(créer, consulter,\nmodifier, supprimer)" as UC_ManageChars
  }
  package "Parties" {
    usecase "Consulter ses parties" as UC_MyParties
    usecase "Créer une partie" as UC_Create
    usecase "Rejoindre une partie" as UC_Join
    usecase "Rejoindre avec\nun code d'invitation" as UC_JoinCode
    usecase "Demander à rejoindre" as UC_JoinRequest
    usecase "Parcourir les\nparties ouvertes" as UC_Browse
    usecase "Choisir son PJ\npour la partie" as UC_PickChar
    usecase "Quitter une partie" as UC_Leave
    usecase "Générer un code\nd'invitation" as UC_InviteCode
    usecase "Traiter les demandes\nd'adhésion" as UC_Requests
    usecase "Régler le mode\nde verdict" as UC_RulingMode
    usecase "Gérer le PJ d'un joueur\nsans téléphone" as UC_PaperChar
  }
  package "Séances" {
    usecase "Ouvrir une séance" as UC_OpenSession
    usecase "Clôturer une séance" as UC_CloseSession
    usecase "Rejoindre la séance\nen cours" as UC_JoinSession
  }
}

User --> UC_ManageChars
User --> UC_MyParties
User --> UC_Create
User --> UC_Join
UC_Join <|-- UC_JoinCode
UC_Join <|-- UC_JoinRequest
UC_Browse <.. UC_JoinRequest : <<extend>>

Player --> UC_PickChar
Player --> UC_Leave
Player --> UC_JoinSession

GM --> UC_InviteCode
GM --> UC_Requests
GM --> UC_RulingMode
GM --> UC_PaperChar
GM --> UC_OpenSession
GM --> UC_CloseSession

note bottom of UC_Create
  Le créateur d'une partie
  en devient le Meneur.
end note

note bottom of UC_JoinSession
  Possible seulement quand
  le Meneur a ouvert la séance.
end note

note bottom of UC_RulingMode
  « Validation par le Meneur » (par défaut)
  ou « résultat des dés ».
end note
@enduml
