@startuml uc-02-personnages-sessions
title Rolliste — Personnages et sessions (v0.2)
!include _style.puml
left to right direction

actor "Utilisateur" as User
actor "Joueur" as Player
actor "Meneur" as GM

User <|-- Player
User <|-- GM

rectangle "Rolliste" {
  package "Personnages" {
    usecase "Gérer ses PJ\n(créer, consulter,\nmodifier, supprimer)" as UC_ManageChars
  }
  package "Sessions" {
    usecase "Consulter ses sessions" as UC_MySessions
    usecase "Créer une session" as UC_Create
    usecase "Rejoindre une session" as UC_Join
    usecase "Rejoindre avec\nun code d'invitation" as UC_JoinCode
    usecase "Demander à rejoindre" as UC_JoinRequest
    usecase "Parcourir les\nsessions ouvertes" as UC_Browse
    usecase "Choisir son PJ\npour la session" as UC_PickChar
    usecase "Quitter une session" as UC_Leave
    usecase "Générer un code\nd'invitation" as UC_InviteCode
    usecase "Traiter les demandes\nd'adhésion" as UC_Requests
  }
}

User --> UC_ManageChars
User --> UC_MySessions
User --> UC_Create
User --> UC_Join
UC_Join <|-- UC_JoinCode
UC_Join <|-- UC_JoinRequest
UC_Browse <.. UC_JoinRequest : <<extend>>

Player --> UC_PickChar
Player --> UC_Leave

GM --> UC_InviteCode
GM --> UC_Requests

note bottom of UC_Create
  Le créateur d'une session
  en devient le Meneur.
end note
@enduml
