@startuml seq-05-generer-code
title Rolliste — Séquence : Générer un code d'invitation (v0.1)
!include ../cas-utilisation/_style.puml
skinparam sequenceMessageAlign left
skinparam BoxPadding 8
hide footbox

' Cas d'utilisation : uc-02 « Générer un code d'invitation ».
' Couches du backend : contrôleur (presentation) → service (application) → repository (infrastructure).

actor "Meneur" as GM
participant ":Application web" as Web

box "Backend (API)" #F4F6FA
  participant ":Contrôleur" as Ctrl
  participant ":Service" as Service
  participant ":Repository" as Repo
end box

database "Base de données" as DB

GM -> Web : clique sur « Générer un code »
activate Web
Web -> Ctrl : POST /tables/{id}/invite-code
activate Ctrl
Ctrl -> Ctrl : vérifie l'authentification (JWT)

alt non connecté
  Ctrl --> Web : 401
  Web --> GM : « Veuillez vous reconnecter »
else connecté
  Ctrl -> Service : générer un code (utilisateur, partie)
  activate Service
  Service -> Repo : chercher la partie
  activate Repo
  Repo -> DB : lecture
  activate DB
  DB --> Repo : partie ou rien
  deactivate DB
  Repo --> Service : partie ou rien
  deactivate Repo

  alt partie introuvable
    Service --> Ctrl : erreur « partie introuvable »
    Ctrl --> Web : 404
    Web --> GM : « Partie introuvable »
  else l'utilisateur n'est pas le Meneur
    Service --> Ctrl : erreur « accès refusé »
    Ctrl --> Web : 403
    Web --> GM : « Seul le Meneur peut inviter »
  else Meneur de la partie
    Service -> Service : génère un code court unique\n(l'ancien code est désactivé)
    Service -> Repo : enregistrer le code
    activate Repo
    Repo -> DB : écriture
    activate DB
    DB --> Repo : ok
    deactivate DB
    Repo --> Service : ok
    deactivate Repo
    Service --> Ctrl : succès (code)
    deactivate Service
    Ctrl --> Web : 201 (code)
    deactivate Ctrl
    Web --> GM : affiche le code à transmettre aux joueurs
    deactivate Web
  end
end
@enduml
