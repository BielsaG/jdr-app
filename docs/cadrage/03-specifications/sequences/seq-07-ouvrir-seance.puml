@startuml seq-07-ouvrir-seance
title Rolliste — Séquence : Ouvrir une séance (v0.1)
!include ../cas-utilisation/_style.puml
skinparam sequenceMessageAlign left
skinparam BoxPadding 8
hide footbox

' Cas d'utilisation : uc-02 « Ouvrir une séance ».
' Couches du backend : contrôleur (presentation) → service (application) → repository (infrastructure).

actor "Meneur" as GM
participant ":Application web" as Web

box "Backend (API)" #F4F6FA
  participant ":Contrôleur" as Ctrl
  participant ":Service" as Service
  participant ":Repository" as Repo
end box

database "Base de données" as DB

GM -> Web : clique sur « Ouvrir une séance »
activate Web
Web -> Ctrl : POST /tables/{id}/sessions
activate Ctrl
Ctrl -> Ctrl : vérifie l'authentification (JWT)

alt non connecté
  Ctrl --> Web : 401
  Web --> GM : « Veuillez vous reconnecter »
else connecté
  Ctrl -> Service : ouvrir une séance (utilisateur, partie)
  activate Service
  Service -> Repo : chercher la partie et sa séance en cours
  activate Repo
  Repo -> DB : lecture
  activate DB
  DB --> Repo : partie, séance en cours ou rien
  deactivate DB
  Repo --> Service : partie, séance en cours ou rien
  deactivate Repo

  alt l'utilisateur n'est pas le Meneur
    Service --> Ctrl : erreur « accès refusé »
    Ctrl --> Web : 403
    Web --> GM : « Seul le Meneur peut ouvrir une séance »
  else une séance est déjà ouverte
    Service --> Ctrl : erreur « séance déjà ouverte »
    Ctrl --> Web : 409
    Web --> GM : écran de la séance en cours
  else aucune séance ouverte
    Service -> Service : crée la séance (ouverte, datée)
    Service -> Repo : enregistrer la séance
    activate Repo
    Repo -> DB : écriture
    activate DB
    DB --> Repo : ok
    deactivate DB
    Repo --> Service : ok
    deactivate Repo
    Service --> Ctrl : succès (séance)
    deactivate Service
    Ctrl --> Web : 201 (séance)
    deactivate Ctrl
    Web --> GM : écran de la séance
    deactivate Web
  end
end
@enduml
